  <key>Label</key><string>com.seulkicho.pullback.memoryprobe</string>
  <key>ProgramArguments</key>
  <array><string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string><string>/Users/seulkicho/pullback/scripts/maintenance/memory_probe_schedule.py</string></array>
